# ==============================================================================
# ComplainAI - Full Stack Deployment Environment Variables
# ==============================================================================

# ==============================================================================
# 1. FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Project Settings)
# ==============================================================================
VITE_API_BASE_URL=https://your-backend-service.onrender.com

# Firebase Web Client Configuration (from Firebase Console -> Project Settings -> General -> Web App)
VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere123456789
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-ABCDEF1234

# ==============================================================================
# 2. BACKEND ENVIRONMENT VARIABLES (Configure in Render Dashboard -> Environment)
# ==============================================================================
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite:///./backend/resolvex.db
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production
COMPLAINAI_SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production
ADMIN_EMAILS=admin@complainai.ai,admin@resolvex.ai
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# Firebase Admin SDK Credentials (from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com"}
