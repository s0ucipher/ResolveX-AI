# ComplainAI - Unified Environment Configuration

# --- Backend (Render / Local) ---
# Port provided by Render automatically in production; defaults to 8000 locally
PORT=8000

# Database URL:
# - Local default: sqlite:///./backend/resolvex.db (or complainai.db)
# - Production: Render PostgreSQL (e.g. postgresql://user:pass@ep-hostname.render.com/complainai_db)
DATABASE_URL=sqlite:///./backend/resolvex.db

# JWT Authentication Secret Key (generate a strong random string in production)
COMPLAINAI_SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production

# Allowed Origins for CORS (comma-separated list of origins)
# Automatically permits *.vercel.app preview URLs via ALLOWED_ORIGIN_REGEX
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000,https://your-frontend-deployment.vercel.app
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# Environment mode ('development' or 'production')
ENVIRONMENT=development

# --- Frontend (Vercel) ---
# Set in Vercel Project Settings > Environment Variables
VITE_API_BASE_URL=https://your-backend-service.onrender.com
