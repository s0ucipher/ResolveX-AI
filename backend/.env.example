# ==============================================================================
# ComplainAI - Backend Environment Variables (Render Dashboard -> Environment)
# ==============================================================================

# Port is automatically assigned by Render ($PORT); default is 8000 locally
PORT=8000
HOST=0.0.0.0

# Database Connection (SQLite locally, PostgreSQL on Render)
DATABASE_URL=sqlite:///./resolvex.db

# JWT & Application Secret Key
SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production
COMPLAINAI_SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production

# Administrator Emails (comma-separated list of emails granted administrative privileges)
ADMIN_EMAILS=admin@complainai.ai,admin@resolvex.ai

# CORS Allowed Origins (comma-separated list of permitted frontend URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# ------------------------------------------------------------------------------
# Firebase Admin SDK Configuration (Render Backend)
# Method 1 (Recommended for Render): Paste entire Service Account JSON string
# Download from: Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
# ------------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com"}

# Method 2 (Alternative discrete variables):
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
