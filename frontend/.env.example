# ==============================================================================
# ComplainAI - Frontend Environment Variables (Vercel Project Settings)
# ==============================================================================
# In Vercel: Project Settings -> Environment Variables

# Backend API Base URL (Your deployed Render URL)
VITE_API_BASE_URL=https://your-backend-service.onrender.com

# ------------------------------------------------------------------------------
# Firebase Client SDK Configuration (Found in Firebase Console -> Project Settings -> General -> Web App)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyYourApiKeyHere123456789
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-ABCDEF1234
