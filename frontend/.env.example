# ResolveX AI - Frontend Environment Configuration (Vercel)
#
# In local development: Leave blank so Vite proxies /api to http://127.0.0.1:8000
# In Vercel production: Set this to your deployed Render backend URL (e.g. https://resolvex-ai-backend.onrender.com)
VITE_API_BASE_URL=https://your-backend-service.onrender.com
